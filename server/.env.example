# EduAI backend muhit o'zgaruvchilari.
# Bu faylni server/.env ga nusxalab, qiymatlarni to'ldiring.
# server/.env .gitignore ichida — u hech qachon git'ga tushmaydi.

PORT=5000
NODE_ENV=development

# MongoDB. Bo'sh qoldirsangiz server baribir ishga tushadi,
# lekin ma'lumotlar bazasiga bog'liq funksiyalar o'chiq bo'ladi.
MONGODB_URI=

# JWT (keyingi bosqichlarda ishlatiladi)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS uchun ruxsat etilgan frontend origin(lar). Vergul bilan ajratish mumkin.
CLIENT_URL=http://localhost:5173

# AI provayderi (ixtiyoriy). Kalit bo'lmasa AI funksiyasi xavfsiz o'chadi.
AI_API_KEY=
AI_API_URL=
AI_MODEL=
