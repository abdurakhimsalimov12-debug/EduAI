# ============================================================
# EduAI — environment variables (namuna)
# Haqiqiy qiymatlarni server/.env faylga yozing. Bu faylga
# hech qachon haqiqiy maxfiy kalitlarni yozmang.
# ============================================================

# --- Backend (server/.env) ---
PORT=5000
NODE_ENV=development

# MongoDB ulanishi (MongoDB Atlas free-tier yoki lokal mongod)
MONGODB_URI=

# JWT uchun maxfiy kalit (uzun tasodifiy satr)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin (CORS uchun)
CLIENT_URL=http://localhost:5173

# --- AI provayderi (ixtiyoriy; bo'lmasa AI funksiyasi o'chadi) ---
AI_API_KEY=
AI_API_URL=
AI_MODEL=

# --- Frontend (client/.env) ---
# VITE_API_URL=http://localhost:5000/api
